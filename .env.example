# Copia este archivo como .env.local para desarrollo y define la misma
# variable en Vercel (Project → Settings → Environment Variables).

# Clave de acceso de Web3Forms. Se obtiene gratis en https://web3forms.com
# vinculándola al correo que recibe los mensajes.
# Sin esta variable, /api/contact responde 500 "not_configured".
WEB3FORMS_ACCESS_KEY=
